# The Workspace's deployment configuration. Copy to `.env` beside
# `docker-compose.yml` and fill in the four values that have no default.
#
# NO SECRET VALUE BELONGS IN THIS FILE OR IN `.env`. The OIDC client secret
# reaches the container as a file mounted from `secrets:` — see
# `docs/PILOT-RUNBOOK.md` for the OpenBao path it is read from and how it gets
# there. A secret in `.env` is a secret in `docker inspect`, in every operator's
# shell history that ran `env`, and in whatever backs up the deploy directory.

# ── Required. The compose file refuses to start without these. ──────────────

# The ONLINE role's DSN. Not the admin role — the app holds no DDL privilege,
# and migrations run separately from the deploy path.
DATABASE_URL=postgresql+psycopg://workspace_app:CHANGE_ME@db-primary.internal:5432/workspace

# The realm's issuer, exactly as it advertises it — verified live against
# https://idp.dotmac.io/realms/dotmac/.well-known/openid-configuration. This
# value is PERMANENT: it is written into every external identity binding, so
# changing it later orphans them rather than renaming them.
WORKSPACE_OIDC_ISSUER=https://idp.dotmac.io/realms/dotmac

# The confidential client that already exists in that realm.
WORKSPACE_OIDC_CLIENT_ID=dotmac-workspace

# MUST match the redirect URI registered on that client EXACTLY — scheme, host,
# port, path. The client is registered with this single URI and no wildcard;
# a mismatch is refused by Keycloak and the message the member sees says
# nothing useful.
WORKSPACE_OIDC_REDIRECT_URL=https://workspace.dotmac.io/login/callback

# ── Optional. Defaults shown; every one is overridable. ─────────────────────

# The local NAME of this provider registration. Stored on every binding and on
# every ceremony, and checked on the way out — so changing it after members are
# bound orphans those bindings. Choose once.
#WORKSPACE_OIDC_PROVIDER_BINDING=primary

# `openid` alone, deliberately. The Workspace reads no profile, no email and no
# group claim: it resolves a verified (issuer, subject) to a local party through
# an explicit binding, and asking for claims it will not read is surface a
# provider logs and an operator has to justify.
#WORKSPACE_OIDC_SCOPES=openid

# Defaults to the issuer plus /.well-known/openid-configuration. Set it only if
# the realm publishes discovery somewhere else.
#WORKSPACE_OIDC_DISCOVERY_URL=

#WORKSPACE_OIDC_HTTP_TIMEOUT_SECONDS=10
#WORKSPACE_OIDC_METADATA_TTL_SECONDS=900
#WORKSPACE_OIDC_CEREMONY_TTL_SECONDS=600
#WORKSPACE_OIDC_CLOCK_SKEW_SECONDS=60

# ── Deployment ──────────────────────────────────────────────────────────────

#WORKSPACE_IMAGE=registry.dotmac.io/dotmac/workspace
#WORKSPACE_TAG=latest

# Loopback, so the reverse proxy is the only way in. Publishing on 0.0.0.0
# bypasses ufw — docker writes its own iptables rules — which is how an
# internal service becomes internet-reachable without anybody changing a
# firewall.
#WORKSPACE_BIND=127.0.0.1
#WORKSPACE_PORT=8000

# The proxy whose forwarded headers are trusted. This decides whether session
# and ceremony cookies carry `Secure`, so a wrong value here is a cookie policy
# derived from a header a client can set.
#
# With the shipped compose file the service is reached through a published port,
# so the peer uvicorn sees is the Docker bridge GATEWAY — not loopback, even
# though the proxy dials `127.0.0.1:8000`. `127.0.0.1` alone matches nothing,
# the forwarded scheme is discarded, and every cookie loses `Secure` silently.
# Include the gateway (find it with `docker inspect -f
# '{{range .NetworkSettings.Networks}}{{.Gateway}}{{end}}' <container>`).
#FORWARDED_ALLOW_IPS=127.0.0.1,172.18.0.1

#ENVIRONMENT=production
#LOG_LEVEL=INFO

# Where the deploy path writes the client secret for the container to read.
# The FILE, never the value.
#WORKSPACE_OIDC_CLIENT_SECRET_PATH=./.secrets/workspace_oidc_client_secret

#READ_ONLY_ROOTFS=true
#TMPFS_SIZE=64m
#HEALTHCHECK_INTERVAL=30s
#HEALTHCHECK_TIMEOUT=10s
#HEALTHCHECK_RETRIES=3
#HEALTHCHECK_START_PERIOD=20s
#LOG_DRIVER=json-file
#LOG_MAX_SIZE=10m
#LOG_MAX_FILE=3

# ── what the kernel refuses to start without in production ──────────────────
# Every value below is FATAL when unset with ENVIRONMENT=production
# (`validate_settings`). They were absent from this file until 2026-08-16, so
# the deployment runbook was "start it, read the traceback, add one, repeat" —
# and the values ended up hand-written on the host instead of in a file anyone
# could review.

# The platform (control) plane's database. It may point at the SAME database as
# DATABASE_URL with a different role: the planes are separated by privilege,
# not necessarily by server. The platform role holds no DDL either — migrations
# run as the admin role from the deploy path.
PLATFORM_DATABASE_URL=postgresql+psycopg://workspace_platform:CHANGE_ME@db.internal:5432/dotmac_workspace

# Host headers this deployment answers to, comma-separated. Fails CLOSED: an
# empty value serves nobody rather than everybody, and a host that is not
# listed gets a refusal rather than a tenant lookup.
TRUSTED_HOSTS=workspace.example.net

# The platform surface's root domain. Distinct from the tenant host above.
PLATFORM_ROOT_DOMAIN=example.net

# Secrets. No defaults anywhere in compose or here beyond these placeholders —
# a committed default for a signing key is a production key that everybody who
# has read the repository already knows. Generate per deployment and keep them
# in the secret store, never in git.
JWT_SECRET=CHANGE_ME_generate_a_long_random_value
SESSION_HASH_SECRET=CHANGE_ME_generate_a_different_long_random_value

# Fatal in production since kernel 0.1.0a97, and absent from this file before
# it — which is exactly how a deployment ends up running on the kernel's own dev
# sentinel. Three requirements, all checked at startup: it must be set, it must
# be at least 32 bytes, and it must DIFFER from both values above. The last is
# not tidiness — one value serving as a session key and a CSRF key means a
# single compromise forges both, and the whole point of the double-submit bridge
# is that the two are independent.
CSRF_SECRET=CHANGE_ME_generate_a_THIRD_long_random_value_at_least_32_bytes
