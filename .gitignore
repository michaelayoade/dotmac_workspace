__pycache__/
*.py[cod]
.venv/
.env
# Where the deploy path writes the OIDC client secret for the container
# to read (docker-compose.yml's `secrets:` default). A real credential
# lands here on a deployed host, inside a checkout — so it is ignored
# before anybody follows the runbook, not after.
.secrets/
.mypy_cache/
.pytest_cache/
.ruff_cache/
dist/
*.egg-info/
# The clean virtualenv `scripts/from_wheel_boot.sh` installs the built wheel
# into. It must never be the repo venv, and it is never committed.
.boot-venv/
